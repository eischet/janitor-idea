<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.eischet.janitoridea</id>
    <name>janitor-idea</name>
    <vendor>eischet</vendor>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
            id="JanitorWarnings"
            displayType="BALLOON"
            isLogByDefault="true"/>
        <notificationGroup
            id="Janitor"
            displayType="BALLOON"
            isLogByDefault="true"/>
        <codeInsight.lineMarkerProvider
            language="Janitor"
            implementationClass="com.github.eischet.janitoridea.repl.JanitorRunLineMarkerProvider"/>
        <fileType
            name="Janitor"
            language="Janitor"
            implementationClass="com.github.eischet.janitoridea.language.JanitorFileType"
            extensions="jan;janitor"/>
        <lang.syntaxHighlighterFactory
            language="Janitor"
            implementationClass="com.github.eischet.janitoridea.highlighting.JanitorSyntaxHighlighterFactory"/>
        <lang.parserDefinition
            language="Janitor"
            implementationClass="com.github.eischet.janitoridea.language.JanitorParserDefinition"/>
        <lang.findUsagesProvider
            language="Janitor"
            implementationClass="com.github.eischet.janitoridea.language.JanitorFindUsagesProvider"/>
        <lang.documentationProvider
            language="Janitor"
            implementationClass="com.github.eischet.janitoridea.language.doc.JanitorDocumentationProvider"/>
        <multiHostInjector implementation="com.github.eischet.janitoridea.language.injection.JanitorMavenScriptInjector"/>
        <psi.referenceContributor
            language="Janitor"
            implementation="com.github.eischet.janitoridea.language.psi.JanitorReferenceContributor"/>
        <toolWindow
            factoryClass="com.github.eischet.janitoridea.repl.JanitorReplToolWindowFactory"
            id="JanitorRepl"
            anchor="bottom"
            sideTool="true"
            icon="/icons/janitor_tool.svg"/>
        <postStartupActivity implementation="com.github.eischet.janitoridea.startup.MyProjectActivity" />
    </extensions>

    <actions>
        <action id="Janitor.RunFile"
                class="com.github.eischet.janitoridea.actions.JanitorRunFileAction"
                text="Run Janitor Script"
                description="Run current Janitor file in the REPL">
            <add-to-group group-id="RunMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
